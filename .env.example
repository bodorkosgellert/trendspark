# Copy to .env. Every one of these is optional — the app runs, and says what is
# missing, with none of them set. EXPO_PUBLIC_ values ship inside the JS bundle,
# so nothing here may be a secret that can spend money on your behalf.

# Voice briefing. Unset: the briefing runs on a synthetic timeline ("Transcript mode").
EXPO_PUBLIC_ELEVENLABS_API_KEY=

# Playbook generation. Unset: the seeded playbooks are used and Regenerate is hidden.
EXPO_PUBLIC_OPENAI_API_KEY=

# Analytics. Project key from eu.posthog.com (EU region for GDPR). Nothing is
# sent until the user opts in on the consent bar.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Email capture on the You tab. Any endpoint that takes a JSON POST:
# Formspree (https://formspree.io/f/xxxxxxx), Tally, Formcarry, Buttondown.
EXPO_PUBLIC_FORM_ENDPOINT=

# Contributions by card. A Polar pay-what-you-want checkout link. Polar is the
# merchant of record and handles EU VAT; set its success URL to
# https://your-domain/contribute?paid=1 so the app can ask for confirmation.
EXPO_PUBLIC_POLAR_CHECKOUT_URL=

# ── x402 machine lane (server/x402-signals.mjs, not the app bundle) ───────────
# Leave X402_PAY_TO empty to run in demo mode: real 402 responses, payment refused.
X402_PAY_TO=
X402_NETWORK=eip155:84532
X402_FACILITATOR=https://x402.org/facilitator
X402_BASE_URL=http://localhost:4020
